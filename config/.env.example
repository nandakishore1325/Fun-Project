# Copy this file to .env and fill in your values

# Your Google Gemini API key (get one FREE at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here

# Target phone number (country code + number, no + sign)
# Example: 919876543210 for +91 98765 43210
TARGET_PHONE_NUMBER=919876543210

# Your name (how you refer to yourself)
YOUR_NAME=Me

# Target person's name
TARGET_NAME=Friend
